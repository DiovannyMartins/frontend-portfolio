{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["js/**/*.ts", "shared/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["server", "functions", "scripts", "dist", "node_modules"]
}
