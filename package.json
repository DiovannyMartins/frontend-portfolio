{
  "name": "frontend-portfolio",
  "version": "1.0.0",
  "description": "Portfólio front-end responsivo com Vite, backend Express e scripts de automação.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n API,WEB -c yellow,cyan \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "sitemap": "node scripts/gerar-sitemap.js",
    "imagens": "node scripts/otimizar-imagens.js",
    "screenshots": "node scripts/capturar-screenshots.js",
    "check": "node scripts/verificar-assets.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3",
    "hono-rate-limiter": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^8.2.1",
    "wrangler": "^4.124.0"
  }
}
