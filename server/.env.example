# Porta do servidor Express
PORT=3001

# Origens autorizadas a chamar a API, separadas por vírgula.
# Em produção, substitua pelo domínio público do seu portfólio.
FRONTEND_ORIGIN=http://localhost:5173

# --- SMTP (opcional em desenvolvimento) ---
# Sem essas variáveis o servidor roda em "modo log": as mensagens do
# formulário aparecem no console em vez de serem enviadas por e-mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Para qual e-mail a mensagem do formulário deve chegar (padrão: SMTP_USER)
EMAIL_DESTINO=seu-email@gmail.com
