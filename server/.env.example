# Porta do servidor local (usada apenas em desenvolvimento)
PORT=3001

# Origens autorizadas a chamar a API, separadas por vírgula.
# Em produção no Cloudflare, o frontend e a API ficam na mesma origem,
# então essa variável só importa se você chamar a API de outro domínio.
FRONTEND_ORIGIN=http://localhost:5173

# Só habilite atrás de um proxy que sobrescreva os headers de IP.
TRUST_PROXY=false

# --- Resend (envio de e-mail) ---
# Sem essas variáveis o servidor roda em "modo log": as mensagens do
# formulário aparecem no console em vez de serem enviadas por e-mail.
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Remetente. Na conta grátis use Onboarding <onboarding@resend.dev>;
# com domínio verificado, use o seu (ex.: contato@seudominio.com).
RESEND_FROM=onboarding@resend.dev

# Para qual e-mail a mensagem do formulário deve chegar (padrão: RESEND_FROM)
EMAIL_DESTINO=seu-email@gmail.com

# --- Cloudflare Turnstile (captcha do formulário) ---
# Sitekey pública: vai no <div id="turnstile" data-sitekey="..."> do index.html.
# Secret key: fica só no servidor. Sem ela, o captcha não é validado.
# Secret key: https://dash.cloudflare.com/ > Turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx
# Opcional, mas recomendado: hostnames permitidos, separados por vírgula.
TURNSTILE_HOSTNAMES=diovanny.dev,www.diovanny.dev,frontend-portfolio-5at.pages.dev
# Opcional: action configurada no widget Turnstile.
TURNSTILE_ACTION=contato

# Em desenvolvimento o fallback registra apenas campos redigidos.
# Use false para desativá-lo.
LOG_EMAIL_FALLBACK=true

# --- Cloudflare (produção) ---
# Em vez do .env, defina essas variáveis no painel do Cloudflare Pages
# (Settings > Environment variables) ou com o wrangler:
#   npx wrangler pages secret put RESEND_API_KEY
#   npx wrangler pages secret put RESEND_FROM
#   npx wrangler pages secret put EMAIL_DESTINO
#   npx wrangler pages secret put TURNSTILE_SECRET_KEY
# Se o site usar domínio próprio, adicione também:
#   FRONTEND_ORIGIN=https://seu-dominio.com
